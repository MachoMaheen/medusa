#!/usr/bin/env bash
# Happilee Commerce — backend bleed guard
# Blocks commits that modify any upstream-tracked Medusa backend package.

FORBIDDEN=$(git diff --cached --name-only | grep -E '^packages/(medusa|framework|types|utils|modules|core|cli)/' || true)
if [ -n "$FORBIDDEN" ]; then
  echo ""
  echo "❌ BACKEND BLEED DETECTED — the following files are off-limits on happilee-skin:"
  echo ""
  echo "$FORBIDDEN" | sed 's/^/    /'
  echo ""
  echo "These paths are upstream-tracked Medusa code. Modifying them breaks the"
  echo "ability to pull Medusa releases cleanly. Revert the changes and find a"
  echo "frontend-only path to your goal."
  echo ""
  echo "If you absolutely need to modify backend code, that requires a written"
  echo "design decision in docs/superpowers/specs/ and human approval. Bypass"
  echo "this guard with --no-verify ONLY after that's been granted."
  echo ""
  exit 1
fi

# Token discipline: no raw hex in committed source (excluding the legitimate token file)
RAW_HEX=$(git diff --cached --name-only -- 'packages/admin/dashboard/src/**/*.tsx' 'packages/admin/dashboard/src/**/*.ts' 'packages/admin/dashboard/src/**/*.css' 2>/dev/null \
  | grep -v 'happilee-tokens.css' \
  | xargs -I {} grep -lE '#[0-9a-fA-F]{6}\b' {} 2>/dev/null || true)
if [ -n "$RAW_HEX" ]; then
  echo "⚠️  Token discipline warning — raw hex literals in:"
  echo "$RAW_HEX" | sed 's/^/    /'
  echo "Use Tailwind tokens (bg-brand-solid) or CSS vars. Add '// happilee:ok' on the line if intentional."
  echo "(Continuing — this is a warning, not a block.)"
fi

exit 0
